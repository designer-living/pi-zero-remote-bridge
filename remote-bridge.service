[Unit]
Description=Remote Bridge - IR Remote to Network Bridge
After=network.target

[Service]
Type=simple
User=remote-bridge
Group=input
EnvironmentFile=/etc/remote-bridge.conf
ExecStart=/usr/local/bin/remote_bridge "${REMOTE_NAME}" "${SERVER_IP}" "${SERVER_PORT}" "${LOG_LEVEL}"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=remote-bridge

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/
ReadWritePaths=/dev/input

[Install]
WantedBy=multi-user.target
